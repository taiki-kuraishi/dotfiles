#!/usr/bin/env bash
#MISE description="Encrypt sops-managed secrets (opencode.jsonc, .gitconfig.local, .gitconfig-work)"
# 平文 -> <平文>.sops.yaml。decrypt と同じ一覧を持つ ("path:sops-type")。
# gitconfig は binary 扱い: sops の ini ストアだと重複キー(helper = の空リセット)や
# コメントが壊れるため、バイト列ごと暗号化する。
set -euo pipefail

# local (taiki-kuraishi) と roppoh dev-pod の 2 鍵。dev-pod には k8s が
# ~/.config/sops/age/keys.txt に専用鍵をマウントする (roppoh k8s/dev-pod/statefulset.yaml)。
AGE_RECIPIENTS="age12806kdsshuusvtl60jh7x5ggv7sk8l43lrsafmeyxkm0frj7cehsdnkuef,age1w9ag9ll407vz0xxjx7mev97vsdgmhp73mn6md98etms7adgk540s4xv8k8"
FILES=(
  "$HOME/.config/opencode/opencode.jsonc:json"
  "$HOME/.gitconfig.local:binary"
  "$HOME/.gitconfig-work:binary"
)

for entry in "${FILES[@]}"; do
  src="${entry%:*}" type="${entry##*:}" dst="${entry%:*}.sops.yaml"
  [ -f "$src" ] || { echo "error: $src does not exist" >&2; exit 1; }
  echo "Encrypting $src -> $dst"
  sops --encrypt --age "$AGE_RECIPIENTS" --input-type "$type" --output-type yaml "$src" > "$dst"
done
