#!/usr/bin/env bash
#MISE description="Encrypt sops-managed secrets (opencode.jsonc, gitconfig work files, ssh signing keys)"
set -euo pipefail

LOCAL="age12806kdsshuusvtl60jh7x5ggv7sk8l43lrsafmeyxkm0frj7cehsdnkuef"
DEV_POD="age1w9ag9ll407vz0xxjx7mev97vsdgmhp73mn6md98etms7adgk540s4xv8k8"
FILES=(
  "$HOME/.config/opencode/opencode.jsonc:json:$LOCAL,$DEV_POD"
  "$HOME/.gitconfig-work-orgs:binary:$LOCAL,$DEV_POD"
  "$HOME/.gitconfig-work:binary:$LOCAL,$DEV_POD"
  "$HOME/.ssh/id_ed25519:binary:$LOCAL,$DEV_POD"
  "$HOME/.ssh/id_ed25519_fancs:binary:$LOCAL,$DEV_POD"
)

for entry in "${FILES[@]}"; do
  IFS=: read -r src type recipients <<<"$entry"
  dst="$src.sops.yaml"
  [ -f "$src" ] || { echo "error: $src does not exist" >&2; exit 1; }
  echo "Encrypting $src -> $dst"
  sops --encrypt --age "$recipients" --input-type "$type" --output-type yaml "$src" > "$dst"
done
