#!/usr/bin/env bash
#MISE description="Encrypt opencode.jsonc"

# Ensure we are using the correct file path
TARGET_FILE="$HOME/.config/opencode/opencode.jsonc"
OUTPUT_FILE="${TARGET_FILE}.sops.yaml"
AGE_RECIPIENT="age12806kdsshuusvtl60jh7x5ggv7sk8l43lrsafmeyxkm0frj7cehsdnkuef"

# Check if source file exists
if [ ! -f "$TARGET_FILE" ]; then
    echo "Error: $TARGET_FILE does not exist."
    exit 1
fi

# Encrypt the file
echo "Encrypting $TARGET_FILE to $OUTPUT_FILE..."
# --indent 2: the sops JSON store defaults to tabs; keep the existing 2-space style
sops --indent 2 --encrypt --age "$AGE_RECIPIENT" --input-type json "$TARGET_FILE" > "$OUTPUT_FILE"

if [ $? -eq 0 ]; then
    echo "Successfully encrypted $TARGET_FILE"
else
    echo "Encryption failed."
    exit 1
fi
