[user]
	name = t-kuraishi_fancs
	# email は ~/.gitconfig-work.local (yadm 管理外) に置く。会社ドメインの
	# 実アドレスを PUBLIC な dotfiles repo に載せないため。
	# noreply は使えない: EMU アカウントには noreply が採番されず、IdP 由来の
	# 1 アドレスしか持てない。noreply で署名すると GitHub 側が email を
	# アカウントに解決できず reason=no_user で Unverified になる（実測済み）。
	#
	# 署名鍵も個人と分ける。コミットの Verified 判定は「author の email が
	# 属するアカウント」に登録された鍵で照合されるため、会社 EMU アカウント側に
	# 登録した鍵で署名しないと Unverified のままになる。
	signingkey = ~/.ssh/id_ed25519_fancs.pub
[credential "https://github.com"]
	username = t-kuraishi_fancs
	helper =
	helper = "!f() { test \"$1\" = get && printf 'password=%s\\n' \"$(gh auth token --user t-kuraishi_fancs)\"; }; f"
[include]
	path = ~/.gitconfig-work.local
