{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
  ],
  timezone: "Asia/Tokyo",

  lockFileMaintenance: {
    enabled: true,
  },

  nix: {
    enabled: true,
  },

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.config/dprint/dprint\\.json$/"],
      matchStrings: [
        "https://plugins\\.dprint\\.dev/(?<depName>[a-z0-9_-]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm",
      ],
      datasourceTemplate: "github-releases",
      packageNameTemplate: "dprint/dprint-plugin-{{{depName}}}",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.config/dprint/dprint\\.json$/"],
      matchStrings: [
        "https://plugins\\.dprint\\.dev/(?<depName>[a-z0-9_-]+/[a-z0-9_-]+)-v(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm",
      ],
      datasourceTemplate: "github-releases",
    },
  ],
}
