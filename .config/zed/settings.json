{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/Library",
    "**/node_modules",
    "**/.cache",
    "**/.npm",
    "**/.cargo/registry",
    "**/.rustup",
    "**/.gradle",
    "**/.m2",
    "**/.venv",
    "**/venv",
    "**/.Trash",
    "**/Pictures/Photos Library.photoslibrary",
    "**/Movies",
    "**/Music",
    "**/Applications"
  ],
  "ssh_connections": [
    {
      "host": "n100.tsar-bmb.org",
      "args": [],
      "projects": []
    },
    {
      "host": "admin-gateway.tailc08b7f.ts.net",
      "username": "user",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/user"
          ]
        },
        {
          "paths": [
            "/home/user/Documents/ghq/github.com/taiki-kuraishi/roppoh"
          ]
        }
      ]
    }
  ],
  "session": {
    "trust_all_worktrees": true
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "terminal_init_command": "",
    "dock": "right",
    "notify_when_agent_waiting": "primary_screen",
    "play_sound_when_agent_done": "always",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "languages": {
    "TypeScript": {
      "show_edit_predictions": true,
      "inlay_hints": {
        "edit_debounce_ms": 200,
      },
      "tab_size": 2,
    },
  },
  "edit_predictions": {
    "disabled_globs": [],
    "mode": "eager",
    "open_ai_compatible_api": {
      "api_url": "https://api.openai.com/v1/chat/completions",
      "model": "gpt-5.4-nano"
    },
    "provider": "none",
  },
  "ui_font_family": "JetBrains Mono",
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "show_whitespaces": "all",
  "format_on_save": "on",
  "terminal": {
    "dock": "bottom",
    "font_family": "0xProto Nerd Font",
    "font_size": 14,
    "line_height": "standard",
    "default_height": 500,
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "vtsls": {
          "autoUseWorkspaceTsdk": true,
          "experimental": {
            "completion": {
              "enableServerSideFuzzyMatch": true,
              "entriesLimit": 10,
            },
          },
        },
        "typescript": {
          "preferGoToSourceDefinition": true,
          "tsserver": {
            "maxTsServerMemory": 24576,
            "enableTracing": false,
            "log": "off",
          },
        },
        "javascript": {
          "preferGoToSourceDefinition": true,
          "tsserver": {
            "maxTsServerMemory": 8192,
            "enableTracing": false,
            "log": "off",
          },
        },
      },
    },
  },
}
