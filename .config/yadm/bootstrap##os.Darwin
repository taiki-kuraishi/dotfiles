#!/bin/sh
set -e

for f in /etc/nix/nix.conf /etc/bashrc /etc/zshrc; do
  if [ -f "$f" ] && [ ! -e "$f.before-nix-darwin" ]; then
    sudo mv "$f" "$f.before-nix-darwin"
  fi
done
HOSTNAME="$(scutil --get LocalHostName)"
sudo env "PATH=$PATH" "NIX_CONFIG=${NIX_CONFIG:-}" nix --extra-experimental-features 'nix-command flakes' \
  run nix-darwin/master#darwin-rebuild -- \
  switch --flake "$HOME/.config/nix#$HOSTNAME"

if command -v mise >/dev/null 2>&1; then
  mise install

  if [ -f "$HOME/.config/sops/age/keys.txt" ]; then
    mise -y -C "$HOME" run decrypt
  else
    echo "warning: $HOME/.config/sops/age/keys.txt not found; skipping sops decrypt (run: mise run decrypt)" >&2
  fi
fi

if command -v bunx >/dev/null 2>&1; then
  bunx skills add mattpocock/skills --skill grill-me -g -y --agent claude-code
fi
