#!/bin/sh
set -e

case "$(uname -m)" in
  x86_64 | amd64) sys=x86_64-linux ;;
  aarch64 | arm64) sys=aarch64-linux ;;
  *)
    echo "unsupported arch: $(uname -m)" >&2
    exit 1
    ;;
esac

nix run github:nix-community/home-manager -- \
  switch -b backup --flake "$HOME/.config/nix#$(whoami)-$sys"

export PATH="$HOME/.nix-profile/bin:$PATH"

mise install --yes

if [ -f "$HOME/.config/sops/age/keys.txt" ]; then
  mise -y -C "$HOME" run decrypt
else
  echo "warning: $HOME/.config/sops/age/keys.txt not found; skipping sops decrypt (run: mise run decrypt)" >&2
fi

if [ ! -x "$HOME/.local/bin/claude" ]; then
  curl -fsSL https://claude.ai/install.sh | bash
fi

if [ ! -x "$HOME/.local/bin/pi" ]; then
  mise x -- npm install -g --prefix "$HOME/.local" --ignore-scripts @earendil-works/pi-coding-agent
fi

# Orca (stably.ai): AppImage needs FUSE at runtime (e.g. libfuse2 on Debian/Ubuntu)
if [ ! -x "$HOME/.local/bin/orca-linux.AppImage" ]; then
  mkdir -p "$HOME/.local/bin"
  curl -fL https://github.com/stablyai/orca/releases/latest/download/orca-linux.AppImage \
    -o "$HOME/.local/bin/orca-linux.AppImage"
  chmod +x "$HOME/.local/bin/orca-linux.AppImage"
fi

mise x -- bunx skills add mattpocock/skills --skill grill-me -g -y --agent claude-code
mise x -- bunx skills add https://github.com/anthropics/claude-code/tree/main/plugins/frontend-design/skills/frontend-design -g -y --agent pi
mise x -- bunx skills add herdrdev/herdr --skill herdr -g -y --agent claude-code
mise x -- bunx skills add herdrdev/herdr --skill herdr -g -y --agent pi
mise x -- bunx skills add https://github.com/stablyai/orca --skill orca-cli --skill computer-use --skill orchestration -g -y --agent pi --agent claude-code

if ! command -v dockerd >/dev/null 2>&1 \
  && [ -d /run/systemd/system ] \
  && sudo -n true 2>/dev/null; then
  curl -fsSL https://get.docker.com | sudo sh
  sudo systemctl enable --now docker
  sudo usermod -aG docker "$(whoami)"
  echo "Added to docker group. Log out and back in for it to take effect." >&2
fi
