#!/bin/sh
# yadm bootstrap (Linux): roppoh リモート開発 Pod など Linux 環境の初期化。
# macOS 側は bootstrap##os.Darwin(nix-darwin ベース)。ユーザー環境の設定本体は
# 両 OS 共通の Home Manager モジュール(~/.config/nix/home-common.nix)で統一している。
set -e

# 1. CPU アーキから該当の homeConfigurations を選択。
case "$(uname -m)" in
  x86_64 | amd64) sys=x86_64-linux ;;
  aarch64 | arm64) sys=aarch64-linux ;;
  *)
    echo "unsupported arch: $(uname -m)" >&2
    exit 1
    ;;
esac

# 2. Home Manager を適用（home-common.nix）。
#    -b backup: Pod イメージ同梱の ~/.zshrc 等があっても衝突せず退避する。
nix run github:nix-community/home-manager -- \
  switch -b backup --flake "$HOME/.config/nix#$(whoami)-$sys"

# 3. HM 導入物をこのシェルの PATH へ（mise/claude を同一実行内で使えるように）。
export PATH="$HOME/.nix-profile/bin:$PATH"

# 4. mise 管理ツール（~/.config/mise/config.toml に従う。mise 本体は HM 導入済み）。
mise install --yes

# 5. sops 管理の秘密情報(会社用 gitconfig, opencode)を復号(~/.mise-tasks/decrypt)。
#    age 鍵は yadm 管理外。先に Bitwarden から復元しておく。無ければスキップする。
if [ -f "$HOME/.config/sops/age/keys.txt" ]; then
  mise -y -C "$HOME" run decrypt
else
  echo "warning: $HOME/.config/sops/age/keys.txt not found; skipping sops decrypt (run: mise run decrypt)" >&2
fi

# 6. Claude Code(ネイティブバイナリ。~/.local 配下に入り、以後は自己更新される)。
if [ ! -x "$HOME/.local/bin/claude" ]; then
  curl -fsSL https://claude.ai/install.sh | bash
fi

# 7. bunx skills をグローバルインストール(bun は mise で導入済み。Darwin bootstrap の手順 4 と同等)。
#    欲しい skill はここに明示的に追加する(lockfile からの復元ではなく宣言的に管理)。
mise x -- bunx skills add mattpocock/skills --skill grill-me -g -y --agent claude-code

# 8. Docker Engine（rootful）。dockerd 未導入 かつ systemd あり かつ
#    非対話 sudo が使える場合のみ導入する no-op safe なステップ。
#    Pod・CI ランナー（既に導入済み）や systemd の無い環境、sudo の無い環境では何もしない。
if ! command -v dockerd >/dev/null 2>&1 \
  && [ -d /run/systemd/system ] \
  && sudo -n true 2>/dev/null; then
  curl -fsSL https://get.docker.com | sudo sh
  sudo systemctl enable --now docker
  sudo usermod -aG docker "$(whoami)"
  echo "Added to docker group. Log out and back in for it to take effect." >&2
fi
